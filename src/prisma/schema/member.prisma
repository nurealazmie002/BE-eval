model Member {
  id          String         @id @default(uuid())
  name        String
  email       String         @unique
  password    String
  phone       String?
  address     String?
  role        Role           @default(MEMBER)
  status      MemberStatus   @default(ACTIVE)

  borrowRecords BorrowRecord[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@map("members")
}

enum Role {
  MEMBER
  ADMIN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}