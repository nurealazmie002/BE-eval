# Database Connection (Railway will auto-inject this)
DATABASE_URL="postgresql://user:password@localhost:5432/perpustakaan_db"

# JWT Secret (required)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Port (Railway sets this automatically)
PORT=3000

# Production Settings (Railway sets these)
NODE_ENV=development

# Base URL for API (optional, Railway provides this)
# BASE_URL="https://your-app.up.railway.app"
